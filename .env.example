# Saarthi — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- MCP server ---
SAARTHI_HOST=127.0.0.1
SAARTHI_PORT=8080
# One of: memory (temporary local records) | neo4j (persistent records)
SAARTHI_BACKEND=memory
# Optional private household JSON for memory mode; empty by default. No built-in demo data.
# Use python -m saarthi_mcp.household FILE --check to validate it first.
SAARTHI_HOUSEHOLD_FILE=
# Optional first-household form on this computer (127.0.0.1:8080 only).
# 0 disables it. 1 enables review + confirmation; existing households are never replaced.
SAARTHI_LOCAL_SETUP=0

# Local mode only binds to loopback. Cognito mode rejects local Calendar/setup routes.
SAARTHI_AUTH=local
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Exact MCP resource URL requested in OAuth resource binding.
COGNITO_RESOURCE_URL=
# Comma-separated Cognito sub UUIDs explicitly allowed into this household.
COGNITO_ALLOWED_SUBJECTS=

# --- Neo4j (Week 2+) ---
# Local dev via Docker: bolt://localhost:7687 / neo4j / password
# Neo4j Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# --- AWS / Bedrock (Week 3+) ---
AWS_REGION=us-east-1
# Required when SAARTHI_AGENTS=bedrock. Pick an ID your account can invoke (inference profile or foundation model).
# Read-only entitlement check (no tokens spent):
#   python scripts/check_bedrock.py --model YOUR_MODEL_ID
# Optional one-shot smoke (16 output tokens max, spends credits):
#   python scripts/check_bedrock.py --invoke YOUR_INFERENCE_PROFILE_ID
# Recommended (probe Oct 12: agreement AVAILABLE + smoke OK): Nova Pro
# BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Cheaper: us.amazon.nova-2-lite-v1:0 | Also AVAILABLE: us.deepseek.r1-v1:0, us.meta.llama3-3-70b-instruct-v1:0
# Claude Sonnet/Haiku: often agreement NOT_AVAILABLE until Marketplace accept — do not select until AVAILABLE.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# off = direct repository handlers (tests/CI). bedrock = Orchestrator + specialists on each routed MCP tool.
SAARTHI_AGENTS=off

# --- Google Calendar (local / Cognito launcher) ---
# Keep GOOGLE_* secrets in ignored .local-artifacts/google-calendar.env (not in mcp-server/.env).
# Point the process at that file: SAARTHI_GOOGLE_CONFIG=<absolute path to google-calendar.env>
# See mcp-server/README.md "Local Google Calendar connection".
SAARTHI_GOOGLE_CONFIG=

# --- Notifications (Week 4+) ---
SNS_TOPIC_ARN=
SES_SENDER_EMAIL=
# Optional: only address allowed for opt-in live SES tests (must match a saved household family email).
SES_APPROVED_RECIPIENT=
FAMILY_CONTACT_PHONE=
FAMILY_CONTACT_EMAIL=

# --- Optional authenticated AWS voice (approved addition) ---
# Requires Polly SynthesizeSpeech and Transcribe StartStreamTranscriptionWebSocket
# in us-east-1. Hosted template enables this; local browser voice remains available.
SAARTHI_AWS_VOICE=0

# --- Watch check-in policy (local day window; silence is not a medical claim) ---
SAARTHI_WATCH_TIMEZONE=Asia/Calcutta
SAARTHI_WATCH_WINDOW_START=08:00
SAARTHI_WATCH_WINDOW_END=21:00
SAARTHI_WATCH_GRACE_HOURS=2
SAARTHI_LOW_SUPPLY_THRESHOLD=10
