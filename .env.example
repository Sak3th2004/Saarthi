# Saarthi — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- MCP server ---
SAARTHI_HOST=127.0.0.1
SAARTHI_PORT=8080
# One of: memory (temporary local records) | neo4j (persistent records)
SAARTHI_BACKEND=memory
# Optional private household JSON for memory mode; empty by default. No built-in demo data.
# Use python -m saarthi_mcp.household FILE --check to validate it first.
SAARTHI_HOUSEHOLD_FILE=
# Optional first-household form on this computer (127.0.0.1:8080 only).
# 0 disables it. 1 enables review + confirmation; existing households are never replaced.
SAARTHI_LOCAL_SETUP=0

# Local mode only binds to loopback. Cognito mode rejects local Calendar/setup routes.
SAARTHI_AUTH=local
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Exact MCP resource URL requested in OAuth resource binding.
COGNITO_RESOURCE_URL=
# Comma-separated Cognito sub UUIDs explicitly allowed into this household.
COGNITO_ALLOWED_SUBJECTS=

# --- Neo4j (Week 2+) ---
# Local dev via Docker: bolt://localhost:7687 / neo4j / password
# Neo4j Aura: neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# --- AWS / Bedrock (Week 3+) ---
AWS_REGION=us-east-1
# Required in bedrock mode. Select an account-verified model; no silent model fallback.
BEDROCK_MODEL_ID=
# off keeps offline/local development free of model calls; bedrock enables the Strands slice.
SAARTHI_AGENTS=off

# --- Notifications (Week 4+) ---
SNS_TOPIC_ARN=
SES_SENDER_EMAIL=
FAMILY_CONTACT_PHONE=
FAMILY_CONTACT_EMAIL=
